# Test suite for {{PACKAGE_NAME}}
import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("{{PACKAGE_NAME}} Test Suite")
    let r = runner_new()

    # 1. Basic facade function
    let res = pkg::hello("Alya")
    runner_assert_str_eq(r, res, "Hello, Alya!", "pkg::hello returns formatted greeting")

    # 2. Default parameter
    let default_res = pkg::hello()
    runner_assert_str_eq(r, default_res, "Hello, World!", "pkg::hello() uses default name")

    # 3. Handling null parameter with is null
    let null_res = pkg::hello(null)
    runner_assert_str_eq(r, null_res, "Hello, World!", "pkg::hello(null) defaults via is null check")

    # 4. Modular types & config constructor
    let cfg = pkg::new_config("Community", 3)
    runner_assert_str_eq(r, cfg.name, "Community", "pkg::new_config sets name correctly")
    runner_assert_str_eq(r, cfg.prefix, "Hello", "pkg::new_config sets default prefix")
    runner_assert_eq(r, cfg.count, 3, "pkg::new_config sets count correctly")

    # 5. Struct method on instance
    let summary_res = cfg.summary()
    runner_assert_str_eq(r, summary_res, "Hello Community (count: 3)", "cfg.summary() struct method works")

    # 6. Core custom formatter using struct
    let custom_res = pkg::core_format_custom(cfg)
    runner_assert_str_eq(r, custom_res, "Hello, Community!", "pkg::core_format_custom formats using config")

    # 7. Pattern matching via when with Formal enum variant
    let cfg_formal = pkg::new_config("Alice", 1, pkg::TemplateStyle.Formal)
    let formal_res = pkg::core_format_custom(cfg_formal)
    runner_assert_str_eq(r, formal_res, "Greetings and Hello, Alice!", "when pattern matches Formal style")

    # 8. Pattern matching via when with Casual enum variant
    let cfg_casual = pkg::new_config("Bob", 1, pkg::TemplateStyle.Casual)
    let casual_res = pkg::core_format_custom(cfg_casual)
    runner_assert_str_eq(r, casual_res, "Hey, Bob!", "when pattern matches Casual style")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
