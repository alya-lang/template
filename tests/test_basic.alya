# Test suite for {{PACKAGE_NAME}}
import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("{{PACKAGE_NAME}} Test Suite")
    let r = runner_new()

    let res = pkg::hello("Alya")
    runner_assert_eq(r, res, "Hello, Alya!", "pkg::hello returns formatted greeting")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
