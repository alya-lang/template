## Test suite for {{PACKAGE_NAME}} native C engine (`native` feature)
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## Exercises the bundled C engine (`c/`, `src/ffi.alya`, `[build]`) through
## the `c_add` facade, with a skip stub when the feature is off.

import "std/test"
import "../src/lib.alya" as pkg

@cfg(feature = "native")
function main()
    test_suite(f"{{PACKAGE_NAME}} Native Engine Tests")
    let r = runner_new()

    let sum = pkg::c_add(10, 32)
    runner_assert_eq(r, sum, 42, "pkg::c_add executes bundled C code")

    let def = pkg::c_add()
    runner_assert_eq(r, def, 0, "pkg::c_add() defaults to 0")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

@cfg(not(feature = "native"))
function main()
    test_suite(f"{{PACKAGE_NAME}} Native Engine Tests (skipped without native feature)")
    let r = runner_new()
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
