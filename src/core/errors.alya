## {{PACKAGE_NAME}} Structured Error Model (feature-gated)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Demonstrates modern error handling: structured `throw` values,
## `try` / `catch err` / `finally` recovery, and `when`-based error
## dispatch. Keep error construction here so `core/pipeline.alya` and
## callers share a single error vocabulary.
## Only compiled when the `strict` feature is active (see `[features]`
## in `alya.toml`); `src/lib.alya` keeps fallback stubs so callers get a
## clear descriptive error instead of an undefined reference.

import "../types.alya"

## Structured error raised for invalid processing input.
##
## Only available when the `strict` feature is active (default-on).
##
## ### Fields
## - `field`: Name of the offending input field.
## - `message`: Human-readable explanation.
@cfg(feature = "strict")
pub struct TemplateError
    field: string,
    message: string
end

## Constructs a `TemplateError` for a missing or empty field value.
##
## Only available when the `strict` feature is active (default-on).
##
## ### Parameters
## - `field`: Name of the offending input field.
## - `message`: Human-readable explanation. Defaults to `"value is required"`.
##
## ### Returns
## A populated `TemplateError` instance.
##
## ### Examples
## ```alya
## throw make_template_error("label", "label must not be empty")
## ```
@cfg(feature = "strict")
pub function make_template_error(field: string, message: string = "value is required") -> TemplateError
    return TemplateError {
        field: field,
        message: message
    }
end

## Validates a processing label, throwing `TemplateError` on empty input.
##
## Only available when the `strict` feature is active (default-on).
##
## ### Parameters
## - `label`: Candidate label string (nullable).
##
## ### Returns
## The sanitized label string.
##
## ### Examples
## ```alya
## try
##     let clean = check_label("Alice")
## catch err
##     say f"rejected: {err}"
## end
## ```
@cfg(feature = "strict")
pub function check_label(label: string?) -> string
    let clean = label ?? ""
    if clean == ""
        throw make_template_error("label", "label must not be empty")
    end
    return clean
end

## Formats a caught error value into a readable diagnostic string.
##
## Dispatches on the error shape with `when`: structured `TemplateError`
## values render field context, anything else renders generically. Prefer
## narrowing with an inline `when` at the `catch` site for hot paths; this
## helper keeps call sites tidy.
##
## ### Parameters
## - `err`: Value captured by a `catch err` clause.
##
## ### Returns
## Formatted diagnostic string.
##
## ### Examples
## ```alya
## try
##     check_label("")
## catch err
##     say format_caught_error(err)
## end
## ```
pub function format_caught_error(err) -> string
    return when err
        is TemplateError => f"TemplateError(field={err.field}): {err.message}"
        else => f"error: {err}"
    end
end
