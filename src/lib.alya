## {{PACKAGE_NAME}} Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Provides top-level greeting functions and configuration constructors.

import "./types.alya"
import "./core/formatter.alya"

## Formats and returns a greeting message for the specified recipient.
##
## Defaults to `"World"` if the name parameter is omitted, empty, or null.
##
## ### Parameters
## - `name`: The name of the recipient to greet. Defaults to `"World"`.
##
## ### Returns
## A formatted greeting string, e.g. `"Hello, World!"`.
##
## ### Examples
## ```alya
## let msg = hello("Alya")
## say msg # "Hello, Alya!"
## ```
pub function hello(name = "World") -> string
    let clean = sanitize_name(name)
    return core_format_greeting(clean)
end

## Constructs a new configuration model instance with specified or default values.
##
## Automatically validates and sanitizes the input name using `sanitize_name`.
##
## ### Parameters
## - `name`: Target recipient name. Defaults to `"World"`.
## - `count`: Number of iterations or repetition limit. Defaults to `1`.
## - `style`: Greeting style variant code (`TemplateStyle`). Defaults to `TemplateStyle.Standard`.
##
## ### Returns
## A newly initialized `TemplateConfig` instance.
##
## ### Examples
## ```alya
## let cfg = new_config("Community", 5, TemplateStyle.Formal)
## ```
pub function new_config(name = "World", count: int = 1, style: int = TemplateStyle.Standard) -> TemplateConfig
    return make_config(name, count, style)
end

## Formats and returns the summary representation of any object satisfying the `Summarizable` interface.
##
## Demonstrates Alya's structural duck-typing polymorphism.
##
## ### Parameters
## - `item`: Any object possessing a matching `summary(self) -> string` method.
##
## ### Returns
## The string returned by the item's `summary()` method.
##
## ### Examples
## ```alya
## let cfg = new_config("Community", 3)
## say format_summary(cfg) # "Hello Community (count: 3)"
## ```
pub function format_summary(item) -> string
    if item is Summarizable
        return item.summary()
    end
    return "Not summarizable"
end
