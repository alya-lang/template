## {{PACKAGE_NAME}} Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Serves as the primary public entry point and facade for the {{PACKAGE_NAME}} package,
## exposing models, enums, constructors, interfaces, and processing workflows.

import "./types.alya"
import "./core/formatter.alya"
import "./core/errors.alya"
import "./core/pipeline.alya"
@cfg(feature = "extras")
import "./core/extras.alya"

# ───────────────────────────────────────────────────────────────
# Primary Facade APIs
# ───────────────────────────────────────────────────────────────

## Formats and returns a greeting message for the specified recipient.
##
## Defaults to `"World"` if the name parameter is omitted, empty, or null.
##
## ### Parameters
## - `name`: The name of the recipient to greet. Defaults to `"World"`.
##
## ### Returns
## A formatted greeting string, e.g. `"Hello, World!"`.
##
## ### Examples
## ```alya
## let msg = hello("Alya")
## say msg # "Hello, Alya!"
## ```
pub function hello(name = "World") -> string
    let clean = sanitize_name(name)
    return core_format_greeting(clean)
end

## Constructs a new configuration model instance with specified or default values.
##
## ### Parameters
## - `name`: Target recipient or entity name. Defaults to `"World"`.
## - `count`: Number of iterations or repetition limit. Defaults to `1`.
## - `priority`: Operational priority level (`TemplatePriority`). Defaults to `TemplatePriority.Normal`.
## - `style`: Formality style variant code (`TemplateStyle`). Defaults to `TemplateStyle.Standard`.
##
## ### Returns
## A newly initialized `TemplateConfig` instance.
##
## ### Examples
## ```alya
## let cfg = new_config("Community", 5, TemplatePriority.High, TemplateStyle.Formal)
## ```
pub function new_config(name = "World", count: int = 1, priority: int = TemplatePriority.Normal, style: int = TemplateStyle.Standard) -> TemplateConfig
    return make_config(name, count, priority, style)
end

## Processes a configuration label through the formatting pipeline, returning a `TemplateResult`.
##
## Thin facade over `pipeline_process` in `src/core/pipeline.alya`: the engine
## owns validation, formatting, and batch orchestration, so complex packages
## can split the engine into per-domain subfolders without changing this API.
##
## ### Parameters
## - `label`: The target entity label string. Defaults to `"World"`.
## - `count`: Counter or repetition count. Defaults to `1`.
## - `priority`: Priority tier. Defaults to `TemplatePriority.Normal`.
##
## ### Returns
## A successful `TemplateResult` containing the formatted summary string.
##
## ### Examples
## ```alya
## let res = process("Alice", 3, TemplatePriority.High)
## say res.message # "OK"
## ```
pub function process(label = "World", count: int = 1, priority: int = TemplatePriority.Normal) -> TemplateResult
    return pipeline_process(label, count, priority)
end

## Processes an array of labels in batch, returning an array of formatted strings.
##
## Thin facade over `pipeline_process_batch`: handles null input safely by
## returning an empty array.
##
## ### Parameters
## - `labels`: Array of label strings to process (or null).
##
## ### Returns
## An array of formatted result strings.
##
## ### Examples
## ```alya
## let results = process_batch(["Alpha", "Beta"])
## ```
pub function process_batch(labels) -> array
    return pipeline_process_batch(labels)
end

## Runs the strict pipeline, throwing `TemplateError` on empty input.
##
## Thin facade over `pipeline_strict_process`: empty or null labels raise a
## structured error instead of falling back to `"World"`. Narrow it with an
## inline `when` at your `catch` site (see `src/core/errors.alya`).
##
## ### Parameters
## - `label`: Candidate label string (nullable).
## - `count`: Counter or repetition count. Defaults to `1`.
## - `priority`: Priority tier. Defaults to `TemplatePriority.Normal`.
##
## ### Returns
## A successful `TemplateResult`.
##
## ### Examples
## ```alya
## try
##     let res = process_strict("Alice")
## catch err
##     let diag = when err
##         is TemplateError => f"TemplateError(field={err.field}): {err.message}"
##         else => f"error: {err}"
##     end
##     say diag
## end
## ```
pub function process_strict(label: string?, count: int = 1, priority: int = TemplatePriority.Normal) -> TemplateResult
    return pipeline_strict_process(label, count, priority)
end

## Runs the strict pipeline, converting errors into failed results.
##
## Thin facade over `try_pipeline_process`: never throws, returning an
## `error_result` for invalid input instead.
##
## ### Parameters
## - `label`: Candidate label string (nullable).
## - `count`: Counter or repetition count. Defaults to `1`.
## - `priority`: Priority tier. Defaults to `TemplatePriority.Normal`.
##
## ### Returns
## Successful result on valid input, failed result otherwise.
##
## ### Examples
## ```alya
## let res = try_process("")
## say res.is_error() # true
## ```
pub function try_process(label: string?, count: int = 1, priority: int = TemplatePriority.Normal) -> TemplateResult
    return try_pipeline_process(label, count, priority)
end

## Formats and returns the summary representation of a configuration.
##
## Demonstrates struct method dispatch and interface satisfaction (`Summarizable`).
##
## ### Parameters
## - `cfg`: A `TemplateConfig` instance.
##
## ### Returns
## The string returned by the config's `summary()` method.
##
## ### Examples
## ```alya
## let cfg = new_config("Community", 3)
## say format_summary(cfg)
## ```
pub function format_summary(cfg: TemplateConfig) -> string
    return cfg.summary()
end

## Formats and returns the description of a configuration.
##
## Demonstrates struct method dispatch and interface satisfaction (`Describable`).
##
## ### Parameters
## - `cfg`: A `TemplateConfig` instance.
##
## ### Returns
## The string returned by `describe()`.
##
## ### Examples
## ```alya
## let cfg = new_config("Project", 1)
## say format_description(cfg)
## ```
pub function format_description(cfg: TemplateConfig) -> string
    return cfg.describe()
end

## Clamps an integer to the closed interval `[min_val, max_val]`.
##
## ### Parameters
## - `n`: Value to clamp.
## - `min_val`: Lower bound.
## - `max_val`: Upper bound.
##
## ### Returns
## Clamped integer within the specified range.
pub function clamp(n: int, min_val: int, max_val: int) -> int
    return clamp_count(n, min_val, max_val)
end

## Returns singular or plural form based on item count.
##
## ### Parameters
## - `n`: The item count.
## - `singular`: Word form for count == 1.
## - `plural`: Word form for counts != 1.
##
## ### Returns
## The selected string based on `n`.
pub function pluralize(n: int, singular: string, plural: string) -> string
    return when n
        is 1 => singular
        else => plural
    end
end

## Returns an array repeating the given string `count` times.
##
## ### Parameters
## - `label`: String to repeat.
## - `count`: Number of occurrences.
##
## ### Returns
## Array of repeated strings.
pub function repeat_string(label: string, count: int) -> array
    return repeat_label(label, count)
end

