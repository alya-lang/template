## {{PACKAGE_NAME}} Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines configuration models, style enumerations, structural interfaces, and associated methods.

## Public interface for objects capable of producing a formatted string summary.
##
## Any struct implementing a `summary(self) -> string` method implicitly
## satisfies this interface via Alya's structural duck-typing runtime.
pub interface Summarizable
    function summary(self) -> string
end

## Public enumeration of greeting formality styles.
##
## Determines the salutation prefix used when formatting custom greetings:
## - `Standard`: Classic friendly greeting (e.g. `"Hello"`).
## - `Formal`: Elevated professional salutation (e.g. `"Greetings and Hello"`).
## - `Casual`: Relaxed informal greeting (e.g. `"Hey"`).
pub enum TemplateStyle
    Standard,
    Formal,
    Casual
end

## Configuration data model holding parameters for greeting generation.
##
## Encapsulates the target name, greeting prefix, repeat count, and stylistic variant.
##
## ### Fields
## - `name`: The validated recipient name.
## - `prefix`: Salutation prefix (defaults to `"Hello"`).
## - `count`: Greeting count or repetition limit.
## - `style`: Formality style enum code (`TemplateStyle` variant stored as integer).
pub struct TemplateConfig
    name: string,
    prefix: string,
    count: int,
    style: int
end

## Sanitizes and validates an input recipient name string.
##
## Defaults to `"World"` if the name parameter is omitted, empty, or null.
##
## ### Parameters
## - `name`: The candidate recipient name.
##
## ### Returns
## The sanitized non-empty recipient string.
pub function sanitize_name(name) -> string
    return when
        name is null => "World"
        name == ""   => "World"
        else         => name
    end
end

## Returns a human-readable formatted summary string of this configuration.
##
## Implicitly satisfies the `Summarizable` interface.
##
## ### Parameters
## - `self`: The target `TemplateConfig` instance.
##
## ### Returns
## Formatted summary string in the form `"{prefix} {name} (count: {count})"`.
##
## ### Examples
## ```alya
## let cfg = new_config("Community", 3)
## say cfg.summary() # "Hello Community (count: 3)"
## ```
pub function TemplateConfig.summary(self: TemplateConfig) -> string
    return "{self.prefix} {self.name} (count: {self.count})"
end

## Returns an updated immutable copy of the configuration with a new validated name.
##
## ### Parameters
## - `self`: The current `TemplateConfig` instance.
## - `new_name`: The replacement name to apply.
##
## ### Returns
## A new `TemplateConfig` instance with updated name and identical prefix, count, and style.
##
## ### Examples
## ```alya
## let updated = cfg.with_name("Contributors")
## ```
pub function TemplateConfig.with_name(self: TemplateConfig, new_name) -> TemplateConfig
    return TemplateConfig {
        name: sanitize_name(new_name),
        prefix: self.prefix,
        count: self.count,
        style: self.style
    }
end

## Factory constructor creating a validated `TemplateConfig` instance.
##
## Sanitizes the input name using `sanitize_name` and assigns the default `"Hello"` prefix.
##
## ### Parameters
## - `name`: Recipient name string. Defaults to `"World"`.
## - `count`: Repetition count. Defaults to `1`.
## - `style`: Formality style variant from `TemplateStyle`. Defaults to `TemplateStyle.Standard`.
##
## ### Returns
## A newly initialized `TemplateConfig` instance.
##
## ### Examples
## ```alya
## let cfg = make_config("World", 1, TemplateStyle.Standard)
## ```
pub function make_config(name = "World", count: int = 1, style: int = TemplateStyle.Standard) -> TemplateConfig
    let valid_name = sanitize_name(name)
    return TemplateConfig {
        name: valid_name,
        prefix: "Hello",
        count: count,
        style: style
    }
end
