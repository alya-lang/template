# Benchmark suite for {{PACKAGE_NAME}}
import "std/bench"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("{{PACKAGE_NAME}} Micro-Benchmarks")

    bench_start(runner, 100000)
    let i = 0
    while i < 100000
        pkg::hello("Alya")
        i += 1
    end
    bench_stop(runner, "hello() 100k calls")

    bench_summary(runner)
end

main()
